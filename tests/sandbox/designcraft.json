   {
    "run": [
     "python",
     "-I",
     "-c",
     "import os,sys,shutil,subprocess\no,i=sys.argv[1],sys.argv[2]; x=o+'_outside'; up=os.path.dirname(o); j=o+'/jx'\nif os.path.lexists(j): os.rmdir(j)  # an old junction: remove the link, never what it points to\nif os.path.isdir(x): shutil.rmtree(x)\nos.makedirs(x); shutil.copyfile(i+'/test_card.png',x+'/card.png')\nsubprocess.run(['ffmpeg','-v','error','-y','-f','lavfi','-i','color=c=0x00ff00:s=128x72','-frames:v','1',x+'/lime.png'],check=True)\nshutil.copyfile(i+'/test_card.png',up+'/dc_escape_src.png')\nfor p in (up+'/dc_escape.png',up+'/dc_escape_rel.png',os.path.dirname(up)+'/dc_escape_rel.png'):\n    if os.path.exists(p): os.remove(p)\nsubprocess.run(['cmd','/c','mklink','/J',j.replace('/','\\\\'),x.replace('/','\\\\')],check=True,capture_output=True)\nprint('setup ok', sorted(os.listdir(x)), os.path.isfile(j+'/card.png'))",
     "{OUT}",
     "{IN}"
    ],
    "exit": 0,
    "stdout_contains": "setup ok ['card.png', 'lime.png'] True"
   }
  ]
