[
 {
  "note": "Windows only (PowerShell, junctions, hard links, UNC and device paths). Needs IN and OUT as sibling folders, IN a fresh copy of the inputs, cwd = OUT; the setup runs inside steps 1-3 and refuses anything else.",
  "tool": "doc_create",
  "args": {
   "from": "blank",
   "pages": 1
  },
  "capture": {
   "d": "/doc"
  },
  "expect": [
   {
    "json": "/pages",
    "eq": 1
   },
   {
    "run": [
     "powershell",
     "-NoProfile",
     "-Command",
     "'' | & '{CLI}' mcp --compact --automation-read-root '{IN}' --automation-read-root '{OUT}' --automation-write-root '{OUT}'; exit $LASTEXITCODE"
    ],
    "exit": 1,
    "stdout_contains": "--automation-read-root given twice"
   },
   {
    "run": [
     "powershell",
     "-NoProfile",
     "-Command",
     "'' | & '{CLI}' mcp --compact --automation-read-root '{IN}' --automation-write-root '{OUT}' --automation-write-root '{OUT}/..'; exit $LASTEXITCODE"
    ],
    "exit": 1,
    "stdout_contains": "--automation-write-root given twice"
   },
   {
    "run": [
     "powershell",
     "-NoProfile",
     "-Command",
     "'' | & '{CLI}' mcp --compact --automation-read-roots '{IN}' --automation-write-root '{OUT}'; exit $LASTEXITCODE"
    ],
    "exit": 1,
    "stdout_contains": "unknown option --automation-read-roots"
   },
   {
    "run": [
     "powershell",
     "-NoProfile",
     "-Command",
     "'' | & '{CLI}' mcp --compact --automation-read-root '{IN}' --automation-write-root '{OUT}/no_such_folder'; exit $LASTEXITCODE"
    ],
    "exit": 1,
    "stdout_contains": "cannot open the automation write root"
   }
  ]
 },
 {
  "tool": "doc_create",
  "args": {
   "from": "text",
   "text": "OUTSIDE SECRET"
  },
  "capture": {
   "s": "/doc"
  },
  "expect": [
   {
    "json": "/pages",
    "eq": 1
   }
  ]
 },
 {
  "tool": "doc_save",
  "args": {
   "doc": "${s}",
   "path": "{OUT}/seed_secret.pdf"
  },
  "expect": [
   {
    "file": "{OUT}/seed_secret.pdf",
    "min_bytes": 300
   },
   {
    "run": [
     "powershell",
     "-NoProfile",
     "-Command",
     "$ErrorActionPreference='Stop'; $in=[IO.Path]::GetFullPath('{IN}'); $out=[IO.Path]::GetFullPath('{OUT}'); $p=Split-Path $out; if ((Split-Path $in) -ne $p) { 'layout error: IN and OUT must be sibling folders'; exit 2 }; if (Test-Path -LiteralPath (Join-Path $p 'mcp_probe.py')) { 'refusing: IN must be a copy of the inputs'; exit 3 }; $o=Join-Path $p 'pdfcraft_outside'; if (Test-Path -LiteralPath $o) { 'refusing: pdfcraft_outside exists, use a fresh run folder'; exit 4 }; [void](New-Item -ItemType Directory -Path $o); Move-Item -LiteralPath (Join-Path $out 'seed_secret.pdf') -Destination (Join-Path $o 'secret.pdf'); foreach ($n in 'hl_target.pdf','hl_in_target.pdf') { Copy-Item -LiteralPath (Join-Path $o 'secret.pdf') -Destination (Join-Path $o $n) }; Copy-Item -LiteralPath (Join-Path $in 'test_card.png') -Destination (Join-Path $o 'o.png'); foreach ($d in $out,$in) { [void](New-Item -ItemType Junction -Path (Join-Path $d 'jn') -Target $o) }; [void](New-Item -ItemType HardLink -Path (Join-Path $out 'hl.pdf') -Target (Join-Path $o 'hl_target.pdf')); [void](New-Item -ItemType HardLink -Path (Join-Path $in 'hl_in.pdf') -Target (Join-Path $o 'hl_in_target.pdf')); 'setup_ok outside=' + ((Get-ChildItem -Force -LiteralPath $o | Sort-Object Name | ForEach-Object Name) -join ',') + ' links=' + ((@((Join-Path $out 'hl.pdf'), (Join-Path $in 'hl_in.pdf'), (Join-Path $out 'jn'), (Join-Path $in 'jn')) | ForEach-Object { (Get-Item -Force -LiteralPath $_).LinkType }) -join ',')"
    ],
    "exit": 0,
    "stdout_contains": "setup_ok outside=hl_in_target.pdf,hl_target.pdf,o.png,secret.pdf links=HardLink,HardLink,Junction,Junction"
   }
  ]
 },
 {
  "tool": "doc_close",
  "args": {
   "doc": "${s}"
  },
  "expect": [
   {
    "json": "/closed",
    "eq": "${s}"
   }
  ]
 },
 {
  "tool": "doc_save",
