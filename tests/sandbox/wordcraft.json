    "stdout_contains":"exit 1: wordcraft-cli: mcp: --automation-read-root given twice","exit":0},
   {"run":["python","-I","-c","import subprocess,sys; r=subprocess.run(sys.argv[1:],stdin=subprocess.DEVNULL,capture_output=True,text=True,timeout=60); print('exit %d: %s' % (r.returncode,r.stderr.strip()))","{CLI}","mcp","--automation-read-root","{IN}","--automation-write-root","{OUT}","--automation-write-root","{OUT}_outside"],
    "stdout_contains":"exit 1: wordcraft-cli: mcp: --automation-write-root given twice","exit":0},
