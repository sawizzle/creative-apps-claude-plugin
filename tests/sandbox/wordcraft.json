[
 {"note":"Sandbox battery for --automation-read-root {IN} --automation-write-root {OUT} (siblings). Uses only {IN} {OUT} {CLI}; needs python on PATH. Steps 2-7 build the fixture: {OUT}_outside (outside both roots: secret.txt, pic.png, tpl.docx with style LeakStyle7731), a junction {OUT}/jlink -> {OUT}_outside, and a bait file next to {OUT}. Independent of the server's working folder ({OUT} or its parent).",
  "tool":"type_text","args":{"text":"Sandbox probe"}},
 {"tool":"new_document","args":{"template":"blank"},"capture":{"t":"/id"}},
 {"tool":"execute","args":{"doc":"${t}","command":"styles.create","params":{"name":"LeakStyle7731"}},
  "expect":[{"json":"/id","eq":"LeakStyle7731"}]},
 {"tool":"type_text","args":{"doc":"${t}","text":"OUTSIDE-DOCX-7731"}},
 {"tool":"execute","args":{"doc":"${t}","command":"para.style","params":{"style":"LeakStyle7731"}}},
 {"tool":"save_document","args":{"doc":"${t}","path":"{OUT}/tpl_src.docx"},
  "expect":[{"json":"/saved","eq":true}]},
 {"tool":"execute","args":{"command":"file.closeDocument","params":{"id":"${t}"}},
  "expect":[{"json":"/active","eq":1},{"json":"/documents","len":1},
   {"run":["python","-I","-c","import os,sys,shutil,subprocess as S; o,i=sys.argv[1],sys.argv[2]; x=o+'_outside'; os.makedirs(x,exist_ok=True); shutil.move(o+'/tpl_src.docx',x+'/tpl.docx'); shutil.copy(i+'/test_card.png',x+'/pic.png'); open(x+'/secret.txt','w').write('OUTSIDE-SECRET-7731'); open(os.path.dirname(o)+'/wc_dotdot_bait.txt','w').write('DOTDOT-BAIT-7731'); j=o+'/jlink'; os.path.isdir(j) or S.run(['cmd','/c','mklink','/J',os.path.normpath(j),os.path.normpath(x)],check=True,capture_output=True); print('fixture ok',sorted(os.listdir(j)))","{OUT}","{IN}"],
    "stdout_contains":"fixture ok ['pic.png', 'secret.txt', 'tpl.docx']","exit":0}]},

 {"note":"Allowed: writes inside the write root, reads inside the read root (including an in-root ..).",
  "tool":"save_document","args":{"path":"{OUT}/sb_in.docx"},
  "expect":[{"json":"/saved","eq":true},{"file":"{OUT}/sb_in.docx","min_bytes":3000},
   {"run":["{CLI}","text","{OUT}/sb_in.docx"],"stdout_contains":"Sandbox probe","exit":0}]},
 {"tool":"save_document","args":{"path":"{OUT}/sb_in.png"},
  "expect":[{"json":"/width","eq":1224},{"media":"{OUT}/sb_in.png","width":1224,"height":1584},
   {"pixel":"{OUT}/sb_in.png","x":600,"y":800,"rgb":[255,255,255],"tol":2}]},
 {"tool":"save_document","args":{"path":"{OUT}/sb_bound.docx"},
  "expect":[{"json":"/saved","eq":true}]},
 {"tool":"execute","args":{"command":"insert.picture","params":{"path":"{IN}/test_card.png","width":50}},
  "expect":[{"json":"/width","eq":50.0},{"json":"/height","eq":28.125}]},
 {"tool":"execute","args":{"command":"insert.picture","params":{"path":"{IN}/sub/../test_card.png","width":50}},
  "expect":[{"json":"/width","eq":50.0}]},
 {"tool":"save_document","args":{"path":"{OUT}/sub/../inroot_dotdot.docx"},
  "expect":[{"json":"/saved","eq":true},{"file":"{OUT}/inroot_dotdot.docx","min_bytes":3000}]},
 {"tool":"save_document","args":{"path":"\\\\.\\{OUT}/dev_ns_in.docx"},
  "expect":[{"json":"/saved","eq":true},{"file":"{OUT}/dev_ns_in.docx","min_bytes":3000}]},

 {"note":"The write root is not readable; the read root is not writable.",
  "tool":"open_document","args":{"path":"{OUT}/sb_in.docx"},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"insert.picture","params":{"path":"{OUT}/sb_in.png","width":50}},"expect_error":"outside the read root"},
 {"tool":"open_document","args":{"path":"sb_in.docx"},"expect_error":"outside the read root"},
 {"tool":"save_document","args":{"path":"{IN}/wc_ro_probe.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{IN}/wc_ro_probe.docx"],"exit":0}]},

 {"note":"Outside both roots: absolute, .., relative .., junction, device namespace.",
  "tool":"open_document","args":{"path":"{OUT}_outside/secret.txt"},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"OUTSIDE-SECRET-7731"}]},
 {"tool":"execute","args":{"command":"insert.picture","params":{"path":"{OUT}_outside/pic.png","width":50}},"expect_error":"outside the read root"},
 {"tool":"save_document","args":{"path":"{OUT}_outside/w.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/w.docx"],"exit":0}]},
 {"tool":"save_document","args":{"path":"{OUT}/../trav.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}/../trav.docx"],"exit":0}]},
 {"tool":"open_document","args":{"path":"{IN}/../wc_dotdot_bait.txt"},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"DOTDOT-BAIT-7731"}]},
 {"tool":"open_document","args":{"path":"{OUT}/../wc_dotdot_bait.txt"},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"DOTDOT-BAIT-7731"}]},
 {"tool":"save_document","args":{"path":"../rel_escape.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; d=os.path.dirname(sys.argv[1]); sys.exit(any(os.path.exists(os.path.join(p,'rel_escape.docx')) for p in (d,os.path.dirname(d))))","{OUT}"],"exit":0}]},
 {"tool":"save_document","args":{"path":"{OUT}/jlink/j.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/j.docx"],"exit":0}]},
 {"tool":"execute","args":{"command":"file.exportPdf","params":{"path":"{OUT}/jlink/j.pdf"}},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/j.pdf"],"exit":0}]},
 {"tool":"save_document","args":{"path":"\\\\.\\{OUT}_outside/dev_ns_out.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/dev_ns_out.docx"],"exit":0}]},
 {"tool":"save_document","args":{"path":"{OUT}/a:x.docx"},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}/a"],"exit":0}]},

 {"note":"Reserved device names, also inside the roots.",
  "tool":"save_document","args":{"path":"{OUT}/NUL.png"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"tool":"save_document","args":{"path":"{OUT}/CON.docx"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"tool":"save_document","args":{"path":"{OUT}/COM1.pdf"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"tool":"save_document","args":{"path":"{OUT}/sub/lpt1.docx"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"tool":"open_document","args":{"path":"{IN}/NUL.txt"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"tool":"open_document","args":{"path":"CON"},"timeout":15,"expect_error":"reserved device names are not allowed"},
 {"note":"Refused, but by a failed resolution (cannot resolve), not by the root check.",
  "tool":"open_document","args":{"path":"\\\\.\\NUL"},"timeout":15,"expect_error":"automation path rejected"},

 {"note":"The same policy inside execute/batch params.",
  "tool":"execute","args":{"command":"file.exportPdf","params":{"path":"{OUT}_outside/sm.pdf"}},"expect_error":"outside the write root"},
 {"tool":"batch","args":{"commands":[{"command":"file.saveAs","params":{"path":"{OUT}_outside/sm.docx"}}]},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/sm.docx"],"exit":0}]},
 {"tool":"execute","args":{"command":"file.exportPng","params":{"path":"{OUT}_outside/sm.png"}},"expect_error":"outside the write root"},
 {"tool":"execute","args":{"command":"file.printPdf","params":{"path":"{OUT}_outside/pp.pdf"}},"expect_error":"outside the write root"},
 {"tool":"execute","args":{"command":"file.saveTemplate","params":{"path":"{OUT}_outside/t.dotx"}},"expect_error":"outside the write root"},
 {"tool":"execute","args":{"command":"insert.textFromFile","params":{"path":"{OUT}_outside/secret.txt"}},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"OUTSIDE-SECRET-7731"}]},
 {"tool":"execute","args":{"command":"file.open","params":{"path":"{OUT}_outside/secret.txt"}},"expect_error":"outside the read root"},
 {"tool":"batch","args":{"commands":[{"command":"file.open","params":{"path":"{OUT}_outside/tpl.docx"}}]},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"file.listTemplates","params":{"dir":"{OUT}_outside"}},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"tpl.docx"}]},
 {"tool":"execute","args":{"command":"mailings.recipients","params":{"path":"{OUT}_outside/secret.txt"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"review.compare","params":{"path":"{OUT}_outside/tpl.docx"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"review.combine","params":{"path":"{OUT}_outside/tpl.docx"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"font.add","params":{"path":"{OUT}_outside/pic.png"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"insert.object","params":{"path":"{OUT}_outside/secret.txt"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"file.newFromTemplate","params":{"path":"{OUT}_outside/tpl.docx"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"styles.copyFrom","params":{"path":"{OUT}_outside/tpl.docx","styles":["LeakStyle7731"]}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"styles.organizer","params":{"path":"{OUT}_outside/tpl.docx"}},"expect_error":"outside the read root",
  "expect":[{"text_not_contains":"LeakStyle7731"}]},
 {"tool":"execute","args":{"command":"tools.updateStyles","params":{"path":"{OUT}_outside/tpl.docx"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"tools.attachTemplate","params":{"path":"{OUT}_outside/tpl.docx","update":true}},"expect_error":"outside the read root"},
 {"note":"attachTemplate without update only records the path; the read is refused when styles are updated from it.",
  "tool":"execute","args":{"command":"tools.attachTemplate","params":{"path":"{OUT}_outside/tpl.docx"}},
  "expect":[{"json":"/template","contains":"tpl.docx"}]},
 {"tool":"execute","args":{"command":"tools.updateStyles","params":{}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"styles.manage","params":{}},
  "expect":[{"text_not_contains":"LeakStyle7731"}]},
 {"tool":"execute","args":{"command":"picture.change","params":{"path":"{OUT}_outside/pic.png"}},"expect_error":"outside the read root"},
 {"tool":"execute","args":{"command":"mailings.recipients","params":{"csv":"Name\nRecipient\n"}},
  "expect":[{"json":"/records","eq":1}]},
 {"tool":"execute","args":{"command":"mailings.finish","params":{"path":"{OUT}_outside/merged.docx"}},"expect_error":"outside the write root"},
 {"note":"Behaviour, not the root check: INCLUDETEXT is never evaluated (also with no roots).",
  "tool":"execute","args":{"command":"insert.field","params":{"instr":"INCLUDETEXT \"{OUT}_outside/secret.txt\""}}},
 {"tool":"execute","args":{"command":"references.updateFields","params":{"all":true}}},
 {"tool":"get_text","args":{},"expect":[{"text_not_contains":"OUTSIDE-SECRET-7731"}]},
 {"note":"A document opened from data but named with an outside path cannot be saved there.",
  "tool":"execute","args":{"command":"file.open","params":{"path":"{OUT}_outside/named.txt","data":"aGVsbG8gZnJvbSBkYXRh"}},
  "expect":[{"json":"/alreadyOpen","eq":false}]},
 {"tool":"save_document","args":{},"expect_error":"outside the write root",
  "expect":[{"run":["python","-I","-c","import os,sys; sys.exit(os.path.exists(sys.argv[1]))","{OUT}_outside/named.txt"],"exit":0}]},
 {"tool":"list_documents","args":{},
  "expect":[{"json":"/documents","len":2}]},

