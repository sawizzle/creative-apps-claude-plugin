 {"note":"Nothing landed outside; the write root holds only the allowed files; remove the junction (rmdir on a junction leaves its target).",
  "tool":"list_documents","args":{},
  "expect":[
   {"run":["python","-I","-c","import os,sys; print('outside', sorted(os.listdir(sys.argv[1]+'_outside')))","{OUT}"],
    "stdout_contains":"outside ['pic.png', 'secret.txt', 'tpl.docx']","exit":0},
   {"run":["python","-I","-c","import os,sys; print('out', sorted(os.listdir(sys.argv[1])))","{OUT}"],
    "stdout_contains":"out ['dev_ns_in.docx', 'inroot_dotdot.docx', 'jlink', 'sb_bound.docx', 'sb_in.docx', 'sb_in.png']","exit":0},
   {"run":["python","-I","-c","import os,sys; o=sys.argv[1]; os.rmdir(o+'/jlink'); print('junction removed', os.path.isfile(o+'_outside/secret.txt'), os.path.exists(o+'/jlink'))","{OUT}"],
