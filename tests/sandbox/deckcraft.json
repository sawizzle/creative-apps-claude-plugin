[
 {"note": "Fixture (Windows; needs python on PATH). Builds every outside file this battery points at, so a refusal is a refusal of a file that exists. {IN} must be a scratch copy of the inputs (tests/run_all_tests.py makes one): this step puts a junction _sbx_jlink inside {IN} and a deck _sbx_dotdot.deckcraft next to it, and the last step removes both. If the folder above {IN} holds mcp_probe.py (the source inputs folder), those two writes are refused and the run fails instead. Works with cwd = {OUT} or its parent, with or without {OUT} as an extra read root.",
  "tool": "new_presentation", "args": {"theme": "Harbor"},
  "expect": [
   {"json": "/slides", "eq": 1},
   {"run": ["python", "-c", "import os,sys; os.makedirs(sys.argv[1], exist_ok=True)", "{OUT}_ext/jtarget"]},
   {"run": ["{CLI}", "run", "--cmd", "slide.new={\"layout\":\"titleOnly\",\"title\":\"OUTSIDE SECRET\"}", "--save", "{OUT}_ext/outside.deckcraft"]},
   {"run": ["{CLI}", "run", "--cmd", "slide.new={\"layout\":\"titleOnly\",\"title\":\"OUTSIDE SECRET\"}", "--save", "{OUT}_ext/jtarget/outside.deckcraft"]},
   {"run": ["{CLI}", "render", "--sample", "--slide", "0", "--scale", "0.1", "{OUT}_ext/outside.png"]},
   {"run": ["python", "-c", "import shutil,sys; shutil.copyfile(sys.argv[1], sys.argv[2])", "{IN}/test_clip.mp4", "{OUT}_ext/outside.mp4"]},
   {"run": ["python", "-c", "import _winapi,os,sys; os.path.isdir(sys.argv[2]) and os.rmdir(sys.argv[2]); _winapi.CreateJunction(sys.argv[1], sys.argv[2])", "{OUT}_ext/jtarget", "{OUT}/jlink"]},
   {"run": ["python", "-c", "import os,sys,shutil; i=sys.argv[1]; os.path.exists(os.path.join(i, '..', 'mcp_probe.py')) and sys.exit('refusing to write next to the source inputs folder; run the sandbox on a scratch copy of the inputs'); shutil.copyfile(sys.argv[2], os.path.join(i, '..', '_sbx_dotdot.deckcraft'))", "{IN}", "{OUT}_ext/outside.deckcraft"]},
   {"run": ["python", "-c", "import os,sys,_winapi; i=sys.argv[1]; os.path.exists(os.path.join(i, '..', 'mcp_probe.py')) and sys.exit('refusing to write into the source inputs folder; run the sandbox on a scratch copy of the inputs'); l=os.path.join(i, '_sbx_jlink'); os.path.isdir(l) and os.rmdir(l); _winapi.CreateJunction(sys.argv[2], l)", "{IN}", "{OUT}_ext/jtarget"]},
   {"file": "{OUT}_ext/outside.deckcraft", "min_bytes": 1000}, {"file": "{OUT}_ext/outside.png", "min_bytes": 500},
   {"file": "{OUT}_ext/outside.mp4", "min_bytes": 1000}, {"file": "{IN}/../_sbx_dotdot.deckcraft", "min_bytes": 1000},
   {"file": "{OUT}/jlink/outside.deckcraft", "min_bytes": 1000}, {"file": "{IN}/_sbx_jlink/outside.deckcraft", "min_bytes": 1000}]},

 {"note": "Allowed: build, read {IN}, write {OUT}.", "tool": "add_slide", "args": {"layout": "titleOnly", "title": "Sandbox ok"}, "expect": [{"json": "/index", "eq": 1}]},
 {"tool": "add_shape", "args": {"preset": "rect", "x": 100, "y": 200, "w": 200, "h": 100, "fill": "#1E8449"}},
 {"tool": "insert_picture", "args": {"path": "{IN}/test_card.png", "x": 400, "y": 200, "w": 160, "h": 90}, "capture": {"pic": "/id"},
  "expect": [{"json": "/id", "gte": 1}]},
 {"tool": "save_presentation", "args": {"path": "{OUT}/sbx_ok.deckcraft"},
  "expect": [{"file": "{OUT}/sbx_ok.deckcraft", "min_bytes": 3000},
             {"zip_text": "{OUT}/sbx_ok.deckcraft", "member": "presentation.json", "contains": "Sandbox ok"}]},
 {"tool": "export", "args": {"path": "{OUT}/sbx_ok.png", "slide": 1, "scale": 1},
  "expect": [{"media": "{OUT}/sbx_ok.png", "width": 960, "height": 540},
             {"pixel": "{OUT}/sbx_ok.png", "x": 200, "y": 250, "rgb": [30, 132, 73], "tol": 6},
             {"pixel": "{OUT}/sbx_ok.png", "x": 480, "y": 227, "rgb": [240, 200, 40], "tol": 12}]},
 {"tool": "export", "args": {"path": "{OUT}/sbx_ok.pdf"}, "expect": [{"file_text": "{OUT}/sbx_ok.pdf", "contains": "%PDF"}]},
 {"note": "A .. that stays inside the root is accepted, and the missing folder it passes through is not created.",
  "tool": "export", "args": {"path": "{OUT}/nosuchdir/../sbx_inner.pdf"},
  "expect": [{"file": "{OUT}/sbx_inner.pdf", "min_bytes": 1000},
             {"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}/nosuchdir"]}]},

 {"note": "A read root grants no write.", "tool": "export", "args": {"path": "{IN}/no.pdf"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{IN}/no.pdf"]}]},

 {"note": "Reads outside every root (the files exist).", "tool": "open_presentation", "args": {"path": "{OUT}_ext/outside.deckcraft"}, "expect_error": "outside the read roots"},
 {"tool": "insert_picture", "args": {"path": "{OUT}_ext/outside.png"}, "expect_error": "outside the read roots"},
 {"note": ".. out of a read root.", "tool": "open_presentation", "args": {"path": "{IN}/../_sbx_dotdot.deckcraft"}, "expect_error": "outside the read roots"},
 {"note": "Junction inside a read root that points outside.", "tool": "open_presentation", "args": {"path": "{IN}/_sbx_jlink/outside.deckcraft"}, "expect_error": "outside the read roots"},
 {"note": "Relative read that leaves the roots (refused by the path check, whether or not the file exists).",
  "tool": "open_presentation", "args": {"path": "../_sbx_rel_read.deckcraft"}, "expect_error": "outside the read roots"},

 {"note": "Writes outside every root: refused and nothing lands.", "tool": "save_presentation", "args": {"path": "{OUT}_ext/w.deckcraft"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}_ext/w.deckcraft"]}]},
 {"tool": "export", "args": {"path": "{OUT}_ext/w.pdf"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}_ext/w.pdf"]}]},
 {"note": ".. out of the write root.", "tool": "export", "args": {"path": "{OUT}/../escape.pdf"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}/../escape.pdf"]}]},
 {"note": "Relative write that leaves the root, under either cwd.", "tool": "save_presentation", "args": {"path": "../rel_escape.deckcraft"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(any(map(os.path.exists, sys.argv[1:])))", "{OUT}/../rel_escape.deckcraft", "{OUT}/../../rel_escape.deckcraft"]}]},
 {"note": "Junction inside the write root that points outside.", "tool": "save_presentation", "args": {"path": "{OUT}/jlink/x.deckcraft"}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}_ext/jtarget/x.deckcraft"]}]},

 {"note": "UNC, fail-closed on an unresolvable share only. A reachable share (refused as outside the roots, even pointing inside one) was measured in a separate run, marked † in the README, because it needs runner-computed UNC paths.",
  "tool": "insert_picture", "args": {"path": "\\\\127.0.0.1\\nosuchshare\\x.png"}, "expect_error": "automation path rejected"},
 {"tool": "save_presentation", "args": {"path": "\\\\127.0.0.1\\nosuchshare\\x.deckcraft"}, "expect_error": "automation path rejected"},

 {"note": "Device names, also as a folder name and in relative form.", "tool": "export", "args": {"path": "{OUT}/NUL.png", "slide": 0}, "expect_error": "reserved device names are not allowed"},
 {"tool": "save_presentation", "args": {"path": "{OUT}/CON"}, "expect_error": "reserved device names are not allowed"},
 {"tool": "save_presentation", "args": {"path": "CON"}, "expect_error": "reserved device names are not allowed"},
 {"tool": "insert_picture", "args": {"path": "{OUT}/nul.png"}, "expect_error": "reserved device names are not allowed"},
 {"tool": "export", "args": {"path": "{OUT}/aux/x.png", "slide": 0}, "expect_error": "reserved device names are not allowed"},
 {"tool": "save_presentation", "args": {"path": "{OUT}/CON/x.deckcraft"}, "expect_error": "reserved device names are not allowed"},
 {"tool": "export", "args": {"path": "{OUT}/COM1.png", "slide": 0}, "expect_error": "reserved device names are not allowed"},
 {"tool": "export", "args": {"path": "{OUT}/lpt1.pdf"}, "expect_error": "reserved device names are not allowed"},

 {"note": "The same paths inside run_command params.", "tool": "run_command", "args": {"command": "file.export", "params": {"path": "{OUT}_ext/smuggle.pdf"}}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}_ext/smuggle.pdf"]}]},
 {"tool": "run_command", "args": {"command": "file.saveAs", "params": {"path": "{OUT}_ext/smuggle.deckcraft"}}, "expect_error": "outside the write roots"},
 {"tool": "run_command", "args": {"command": "file.save", "params": {"path": "{OUT}_ext/smuggle2.deckcraft"}}, "expect_error": "outside the write roots"},
 {"tool": "run_command", "args": {"command": "file.saveTemplate", "params": {"path": "{OUT}_ext/smuggle.potx"}}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(any(map(os.path.exists, sys.argv[1:])))", "{OUT}_ext/smuggle.deckcraft", "{OUT}_ext/smuggle2.deckcraft", "{OUT}_ext/smuggle.potx"]}]},
 {"tool": "run_command", "args": {"command": "file.open", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "file.adopt", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "insert.picture", "params": {"path": "{OUT}_ext/outside.png"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "slide.reuseList", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "slide.reuse", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "design.browseTheme", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "review.compare", "params": {"path": "{OUT}_ext/outside.deckcraft"}}, "expect_error": "outside the read roots"},
 {"note": "Picture replace: refused outside (the picture keeps its pixels), works inside.",
  "tool": "run_command", "args": {"command": "picture.change", "params": {"path": "{OUT}_ext/outside.png", "ids": ["${pic}"]}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "slide.colorAt", "params": {"slide": 1, "x": 480, "y": 227}}, "expect": [{"json": "/color", "eq": "F0C828"}]},
 {"tool": "run_command", "args": {"command": "picture.change", "params": {"path": "{IN}/test_card.jpg", "ids": ["${pic}"]}}, "expect": [{"json": "", "eq": 1}]},
 {"note": "Media and sounds: refused outside (a playable clip exists there), work inside.",
  "tool": "run_command", "args": {"command": "insert.video", "params": {"path": "{OUT}_ext/outside.mp4"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "insert.video", "params": {"path": "{IN}/test_clip.mp4"}}, "expect": [{"json": "/playable", "eq": true}]},
 {"tool": "run_command", "args": {"command": "insert.audio", "params": {"path": "{OUT}_ext/outside.mp4"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "insert.audio", "params": {"path": "{IN}/test_clip.mp4"}}, "expect": [{"json": "/playable", "eq": true}]},
 {"tool": "run_command", "args": {"command": "transition.sound", "params": {"path": "{OUT}_ext/outside.mp4"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "transition.sound", "params": {"path": "{IN}/test_clip.mp4"}}, "expect": [{"json": "/sound", "eq": "test_clip.mp4"}]},
 {"note": "SmartArt node pictures: refused outside, work inside.",
  "tool": "run_command", "args": {"command": "insert.smartArt", "params": {"kind": "list", "items": ["one", "two"]}}, "capture": {"sa": "/id"}},
 {"tool": "run_command", "args": {"command": "smartArt.layout", "params": {"id": "${sa}", "kind": "pictureList"}}},
 {"tool": "run_command", "args": {"command": "smartArt.picture", "params": {"id": "${sa}", "index": 0, "path": "{OUT}_ext/outside.png"}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "smartArt.picture", "params": {"id": "${sa}", "index": 0, "path": "{IN}/test_card.png"}}},
 {"note": "Photo albums: refused outside, work inside.",
  "tool": "run_command", "args": {"command": "insert.photoAlbum", "params": {"pictures": [{"path": "{OUT}_ext/outside.png"}]}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "insert.photoAlbum", "params": {"pictures": [{"path": "{IN}/test_card.png"}]}}, "expect": [{"json": "/pictures", "eq": 1}]},
 {"tool": "run_command", "args": {"command": "insert.photoAlbumEdit", "params": {"pictures": [{"path": "{OUT}_ext/outside.png"}]}}, "expect_error": "outside the read roots"},
 {"tool": "run_command", "args": {"command": "insert.photoAlbumEdit", "params": {"pictures": [{"path": "{IN}/test_card.jpg"}]}}, "expect": [{"json": "/pictures", "eq": 1}]},

 {"note": "The same paths inside batch.", "tool": "batch", "args": {"commands": [{"command": "file.export", "params": {"path": "{OUT}_ext/batch.pdf"}}]}, "expect_error": "outside the write roots",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}_ext/batch.pdf"]}]},
 {"tool": "batch", "args": {"commands": [{"command": "file.open", "params": {"path": "{OUT}_ext/outside.deckcraft"}},
                                          {"command": "file.saveAs", "params": {"path": "{OUT}_ext/batch2.deckcraft"}}], "keepGoing": true},
  "expect": [{"json": "/0/ok", "eq": false}, {"json": "/0/error", "contains": "outside the read roots"},
             {"json": "/1/ok", "eq": false}, {"json": "/1/error", "contains": "outside the write roots"}]},

 {"note": "Not a root check (passes the same with no roots): a stream suffix is not refused by the check; the write fails with os error 87 and leaves an empty a.png and no stream.",
  "tool": "export", "args": {"path": "{OUT}/a.png:x", "slide": 0}, "expect_error": "os error 87",
  "expect": [{"file": "{OUT}/a.png", "min_bytes": 0},
             {"run": ["python", "-c", "import os,sys; sys.exit(os.path.getsize(sys.argv[1]) != 0)", "{OUT}/a.png"]},
             {"run": ["python", "-c", "import sys; open(sys.argv[1], 'rb')", "{OUT}/a.png:x"], "exit": 1}]},
 {"note": "Not a root check: missing parent folders are not created (os error 3).",
  "tool": "export", "args": {"path": "{OUT}/newdir/x.pdf"}, "expect_error": "os error 3",
  "expect": [{"run": ["python", "-c", "import os,sys; sys.exit(os.path.exists(sys.argv[1]))", "{OUT}/newdir"]}]},
 {"note": "Not a root check: a second export to the same file overwrites it without asking.",
  "tool": "export", "args": {"path": "{OUT}/ow.txt"}, "expect": [{"file_text": "{OUT}/ow.txt", "contains": "Sandbox ok"}]},
 {"tool": "add_slide", "args": {"layout": "titleOnly", "title": "Overwritten"}},
 {"tool": "export", "args": {"path": "{OUT}/ow.txt"}, "expect": [{"file_text": "{OUT}/ow.txt", "contains": "Overwritten"}]},

 {"note": "Nothing outside was loaded, and the active deck never changed.", "tool": "run_command", "args": {"command": "text.find", "params": {"text": "OUTSIDE SECRET"}}, "expect": [{"json": "", "len": 0}]},
 {"tool": "run_command", "args": {"command": "file.info", "params": {}}, "expect": [{"json": "/path", "contains": "sbx_ok.deckcraft"}]},
 {"note": "Nothing landed outside (the outside folders hold only the fixture files). Then cleanup: remove the junctions and the deck next to {IN}, and check they are gone while the junction target survives.",
  "tool": "run_command", "args": {"command": "file.info", "params": {}},
  "expect": [
   {"run": ["python", "-c", "import os,sys; s=sorted(os.listdir(sys.argv[1])); print(s); sys.exit(s != ['jtarget', 'outside.deckcraft', 'outside.mp4', 'outside.png'])", "{OUT}_ext"]},
   {"run": ["python", "-c", "import os,sys; s=sorted(os.listdir(sys.argv[1])); print(s); sys.exit(s != ['outside.deckcraft'])", "{OUT}_ext/jtarget"]},
   {"run": ["python", "-c", "import os,sys; [os.rmdir(p) for p in sys.argv[1:] if os.path.isdir(p)]", "{IN}/_sbx_jlink", "{OUT}/jlink"]},
   {"run": ["python", "-c", "import os,sys; os.path.exists(sys.argv[1]) and os.remove(sys.argv[1])", "{IN}/../_sbx_dotdot.deckcraft"]},
   {"run": ["python", "-c", "import os,sys; sys.exit(any(map(os.path.lexists, sys.argv[1:])))", "{IN}/_sbx_jlink", "{OUT}/jlink", "{IN}/../_sbx_dotdot.deckcraft"]},
   {"file": "{OUT}_ext/jtarget/outside.deckcraft", "min_bytes": 1000}]}
]
