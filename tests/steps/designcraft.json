     "import json,os,re,sys,zipfile\nd=sys.argv[1]; fs=os.listdir(d)\ndc=[f for f in fs if f.endswith('.designcraft')]; idml=[f for f in fs if f.endswith('.idml')]\nlinks=[a.get('link') for a in json.loads(zipfile.ZipFile(os.path.join(d,dc[0])).read('document.json'))['assets'].values()]\nz=zipfile.ZipFile(os.path.join(d,idml[0]))\nuris=[u for n in z.namelist() for u in re.findall(r'LinkResourceURI=\"([^\"]*)\"',z.read(n).decode('utf-8','replace'))]\nok=links==['Links/test_card.png'] and uris==['file:Links/test_card.png']\nprint(sorted(fs),links,uris,'relative links ok' if ok else 'BAD'); sys.exit(not ok)",
     "{OUT}/pkg"
    ],
