[
 {
  "tool": "new_drawing",
  "args": {
   "metric": true
  },
  "expect": [
   {
    "json": "/index",
    "gte": 0
   },
   {
    "json": "/title",
    "exists": true
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "getvar",
   "params": {
    "name": "MEASUREMENT"
   }
  },
  "expect": [
   {
    "json": "/value",
    "eq": 1
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "layer.new",
   "params": {
    "name": "Outline",
    "color": "red",
    "current": true
   }
  }
 },
 {
  "tool": "command_line",
  "args": {
   "text": "rectang 0,0 100,60"
  },
  "expect": [
   {
    "json": "/running",
    "eq": null
   },
   {
    "json": "/error",
    "exists": false
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "circle",
   "params": {
    "center": [
     50,
     30
    ],
    "radius": 20
   }
  },
  "capture": {
   "circ": "/handle"
  }
 },
 {
  "tool": "execute",
  "args": {
   "command": "hatch",
   "params": {
    "handles": [
     "${circ}"
    ],
    "pattern": "SOLID"
   }
  },
  "capture": {
   "hat": "/handle"
  },
  "expect": [
   {
    "json": "/handles",
    "len": 1
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "move",
   "params": {
    "handles": [
     "${circ}"
    ],
    "delta": [
     10,
     0
    ]
   }
  },
  "expect": [
   {
    "json": "/moved",
    "eq": 1
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "properties.set",
   "params": {
    "handles": [
     "${hat}"
    ],
    "color": "green"
   }
  },
  "expect": [
   {
    "json": "/changed",
    "eq": 1
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "layer.new",
   "params": {
    "name": "Notes",
    "color": "blue",
    "current": true
   }
  }
 },
 {
  "tool": "execute",
  "args": {
   "command": "style",
   "params": {
    "name": "Title",
    "font": "Arial",
    "current": true
   }
  },
  "expect": [
   {
    "json": "/current",
    "eq": "Title"
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "text",
   "params": {
    "at": [
     10,
     70
    ],
    "text": "MCP smoke test",
    "height": 6
   }
  },
  "capture": {
   "txt": "/handle"
  }
 },
 {
  "tool": "execute",
  "args": {
   "command": "properties.set",
   "params": {
    "handles": [
     "${txt}"
    ],
    "widthFactor": 1.2
   }
  },
  "expect": [
   {
    "json": "/changed",
    "eq": 1
   }
  ]
 },
 {
  "tool": "execute",
  "args": {
   "command": "dimlinear",
   "params": {
    "p1": [
     0,
     0
    ],
    "p2": [
     100,
     0
    ],
    "at": [
     50,
     -12
    ]
   }
  },
  "capture": {
   "dim": "/handle"
  }
 },
 {
  "tool": "query_entities",
  "args": {
   "type": "Circle"
  },
  "expect": [
   {
    "json": "/count",
    "eq": 1
   },
   {
    "json": "/entities/0/geometry/center/x",
    "approx": 60,
    "tol": 1e-06
   },
   {
    "json": "/entities/0/geometry/radius",
    "approx": 20,
    "tol": 1e-06
   },
   {
    "json": "/entities/0/layer",
    "eq": "Outline"
   }
  ]
 },
 {
  "tool": "query_entities",
  "args": {
   "type": "Hatch"
  },
  "expect": [
   {
    "json": "/entities/0/handle",
    "eq": "${hat}"
   },
   {
    "json": "/entities/0/color",
    "eq": "Green"
   },
   {
    "json": "/entities/0/geometry/solid",
    "eq": true
   },
   {
    "json": "/entities/0/geometry/associative",
    "eq": true
   },
   {
    "json": "/entities/0/geometry/loops/0/vertices/0/p/x",
    "approx": 40,
    "tol": 1e-06
   },
   {
    "json": "/entities/0/geometry/loops/0/vertices/1/p/x",
    "approx": 80,
    "tol": 1e-06
   }
  ]
 },
 {
  "tool": "query_entities",
  "args": {
   "type": "Dimension"
  },
  "expect": [
   {
    "json": "/entities/0/handle",
    "eq": "${dim}"
   },
   {
    "json": "/entities/0/geometry/measurement",
    "approx": 100,
    "tol": 1e-06
   },
   {
    "json": "/entities/0/geometry/block",
    "eq": null
   }
  ]
 },
 {
  "tool": "inspect_drawing",
  "args": {
   "entities": false
  },
  "expect": [
   {
    "json": "/counts",
    "eq": {
     "Circle": 1,
     "Dimension": 1,
     "Hatch": 1,
     "Polyline": 1,
     "Text": 1
    }
   },
   {
    "json": "/currentLayer",
    "eq": "Notes"
   },
   {
    "json": "/dirty",
    "eq": true
   },
   {
    "json": "/path",
    "eq": null
   }
  ]
 },
 {
  "tool": "render",
  "args": {
   "window": [
    [
     -20,
     -20
    ],
    [
     140,
     80
    ]
   ],
   "width": 800,
   "height": 500
  },
  "expect": [
   {
    "media": "$img",
    "width": 800,
    "height": 500
   },
   {
    "pixel": "$img",
    "x": 400,
    "y": 250,
    "rgb": [
     0,
     255,
     0
    ],
    "tol": 10
   },
   {
    "pixel": "$img",
    "x": 475,
    "y": 250,
    "rgb": [
     0,
     255,
     0
    ],
    "tol": 10
   },
   {
    "pixel": "$img",
    "x": 275,
    "y": 250,
    "rgb": [
     33,
     40,
     48
    ],
    "tol": 10
   },
   {
    "pixel": "$img",
    "x": 700,
    "y": 450,
    "rgb": [
     33,
     40,
     48
    ],
    "tol": 10
   }
  ]
 },
 {
  "tool": "save",
  "args": {
   "path": "{OUT}/cadcraft_smoke.dxf"
  },
