[
 {"tool":"inspect_document","args":{"depth":0},
  "expect":[{"json":"/artboards/0/width","eq":612},{"json":"/artboards/0/height","eq":792},{"json":"/history","len":0}]},
 {"tool":"draw_shape","args":{"shape":"rectangle","x":0,"y":0,"width":612,"height":792,"fill":"#ffffff","stroke":"none","name":"BG"},
  "capture":{"bg":"/id"}},
 {"tool":"draw_shape","args":{"shape":"rectangle","x":50,"y":50,"width":300,"height":200,"radius":16,"fill":"#ff6633","stroke":"none","name":"Card"},
  "capture":{"card":"/id"},"expect":[{"json":"/paint/fill","eq":"#ff6633"}]},
 {"tool":"draw_shape","args":{"shape":"ellipse","x":400,"y":80,"width":120,"height":120,"fill":"#2255cc","stroke":"none","name":"Dot"},
  "capture":{"dot":"/id"}},
 {"tool":"add_text","args":{"text":"draft title","x":70,"y":120,"size":32,"color":"#ffffff"},
  "capture":{"txt":"/id"}},
 {"tool":"set_paint","args":{"ids":["${card}"],"fill":"#22aa44"},
  "expect":[{"json":"/objects","eq":1},{"json":"/applied/fill","eq":"#22aa44"}]},
 {"tool":"transform","args":{"ids":["${dot}"],"dy":300},
  "expect":[{"json":"/applied","contains":"move"}]},
 {"tool":"run_command","args":{"command":"text.setText","params":{"id":"${txt}","text":"VectorCraft smoke"}},
  "expect":[{"json":"/ids/0","eq":"${txt}"}]},
 {"tool":"run_command","args":{"command":"document.node","params":{"id":"${card}","summary":true}},
  "expect":[{"json":"/fill","eq":"#22aa44"},{"json":"/bounds/x","approx":50,"tol":0.01},{"json":"/name","eq":"Card"}]},
 {"tool":"run_command","args":{"command":"document.node","params":{"id":"${dot}","summary":true}},
  "expect":[{"json":"/bounds/y","approx":380,"tol":0.01},{"json":"/kind","eq":"Ellipse"}]},
 {"tool":"run_command","args":{"command":"document.find","params":{"text":"VectorCraft smoke"}},
  "expect":[{"json":"/total","eq":1},{"json":"/matches/0/id","eq":"${txt}"}]},
 {"tool":"render_preview","args":{},
  "expect":[{"media":"$img","width":612,"height":792},
            {"pixel":"$img","x":60,"y":240,"rgb":[34,170,68],"tol":6},
            {"pixel":"$img","x":460,"y":440,"rgb":[34,85,204],"tol":6},
            {"pixel":"$img","x":460,"y":140,"rgb":[255,255,255],"tol":6}]},
 {"tool":"export","args":{"path":"{OUT}/vectorcraft_smoke.png","scale":2},
  "expect":[{"json":"/format","eq":"png"},
            {"media":"{OUT}/vectorcraft_smoke.png","width":1224,"height":1584},
            {"pixel":"{OUT}/vectorcraft_smoke.png","x":120,"y":480,"rgb":[34,170,68],"tol":6},
            {"pixel":"{OUT}/vectorcraft_smoke.png","x":920,"y":880,"rgb":[34,85,204],"tol":6},
            {"pixel":"{OUT}/vectorcraft_smoke.png","x":920,"y":280,"rgb":[255,255,255],"tol":6}]},
 {"tool":"export","args":{"path":"{OUT}/vectorcraft_smoke.svg"},
  "expect":[{"json":"/format","eq":"svg"},
            {"file_text":"{OUT}/vectorcraft_smoke.svg","contains":"fill=\"#22aa44\""},
            {"file_text":"{OUT}/vectorcraft_smoke.svg","contains":">VectorCraft smoke</tspan>"}]},
 {"tool":"save_file","args":{"path":"{OUT}/vectorcraft_smoke.vectorcraft"},
  "expect":[{"json":"/format","eq":"vectorcraft"},{"json":"/warnings","len":0},
            {"file":"{OUT}/vectorcraft_smoke.vectorcraft","min_bytes":1000},
            {"run":["{CLI}","info","{OUT}/vectorcraft_smoke.vectorcraft"],"stdout_contains":"\"Ellipse\": 1"}]},
 {"restart":true},
 {"tool":"open_file","args":{"path":"{OUT}/vectorcraft_smoke.vectorcraft"},
  "expect":[{"json":"/format","eq":"vectorcraft"},{"json":"/warnings","len":0},{"json":"/title","eq":"vectorcraft_smoke.vectorcraft"}]},
 {"tool":"inspect_document","args":{"depth":0},
  "expect":[{"json":"/dirty","eq":false},{"json":"/history","len":0},{"json":"/objects","eq":5},
            {"json":"/title","eq":"vectorcraft_smoke.vectorcraft"}]},
 {"tool":"run_command","args":{"command":"document.node","params":{"id":"${card}","summary":true}},
  "expect":[{"json":"/fill","eq":"#22aa44"},{"json":"/name","eq":"Card"},{"json":"/bounds/x","approx":50,"tol":0.01}]},
 {"tool":"run_command","args":{"command":"document.node","params":{"id":"${dot}","summary":true}},
  "expect":[{"json":"/bounds/y","approx":380,"tol":0.01},{"json":"/fill","eq":"#2255cc"}]},
 {"tool":"run_command","args":{"command":"document.find","params":{"text":"VectorCraft smoke"}},
  "expect":[{"json":"/total","eq":1},{"json":"/matches/0/kind","eq":"Type"}]},
 {"tool":"render_preview","args":{},
  "expect":[{"media":"$img","width":612,"height":792},
            {"pixel":"$img","x":60,"y":240,"rgb":[34,170,68],"tol":6},
            {"pixel":"$img","x":460,"y":440,"rgb":[34,85,204],"tol":6},
            {"pixel":"$img","x":460,"y":140,"rgb":[255,255,255],"tol":6}]},
 {"tool":"export","args":{"path":"{OUT}/vectorcraft_reopen.png"},
  "expect":[{"json":"/format","eq":"png"},
            {"media":"{OUT}/vectorcraft_reopen.png","width":612,"height":792},
            {"pixel":"{OUT}/vectorcraft_reopen.png","x":60,"y":240,"rgb":[34,170,68],"tol":6},
            {"pixel":"{OUT}/vectorcraft_reopen.png","x":460,"y":440,"rgb":[34,85,204],"tol":6},
            {"pixel":"{OUT}/vectorcraft_reopen.png","x":460,"y":140,"rgb":[255,255,255],"tol":6}]}
]
