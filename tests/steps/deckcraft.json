[
 {"tool": "new_presentation", "args": {"theme": "Harbor"},
  "expect": [{"json": "/slides", "eq": 1}]},
 {"tool": "add_slide", "args": {"layout": "titleAndContent", "title": "DeckCraft smoke", "body": "Alpha line\nBeta line"},
  "capture": {"slide_id": "/id"},
  "expect": [{"json": "/index", "eq": 1}]},
 {"tool": "add_shape", "args": {"preset": "rect", "x": 600, "y": 330, "w": 300, "h": 140, "text": "Cost", "fill": "#2E86C1"},
  "capture": {"shape_id": "/id"}},
 {"tool": "run_command", "args": {"command": "format.bold", "params": {"on": true}}},
 {"tool": "run_command", "args": {"command": "format.size", "params": {"size": 36}}},
 {"tool": "run_command", "args": {"command": "format.state", "params": {}},
  "expect": [{"json": "/bold", "eq": true}, {"json": "/size", "eq": 36}]},
 {"tool": "run_command", "args": {"command": "shape.fill", "params": {"ids": ["${shape_id}"], "color": "#1E8449"}}},
 {"tool": "run_command", "args": {"command": "shape.inspect", "params": {"id": "${shape_id}"}},
  "expect": [{"json": "/shape/fill/color/base/rgb/r", "eq": 30}, {"json": "/shape/fill/color/base/rgb/g", "eq": 132},
             {"json": "/shape/fill/color/base/rgb/b", "eq": 73}, {"json": "/box/x", "eq": 600}, {"json": "/box/w", "eq": 300}]},
 {"tool": "add_text_box", "args": {"x": 60, "y": 440, "w": 480, "text": "Styled caption", "size": 28, "color": "#C0392B"},
  "capture": {"cap_id": "/id"}},
 {"tool": "insert_picture", "args": {"path": "{IN}/test_card.png", "x": 640, "y": 160, "w": 256, "h": 144},
  "capture": {"pic_id": "/id"}},
 {"tool": "inspect_slide", "args": {},
  "expect": [{"json": "/id", "eq": "${slide_id}"}, {"json": "/shapes", "len": 5},
             {"json": "/shapes/0/text", "eq": "DeckCraft smoke"}, {"json": "/shapes/2/fill", "eq": "#1E8449"},
             {"json": "/shapes/3/text", "eq": "Styled caption"}, {"json": "/shapes/4/kind", "eq": "picture"},
             {"json": "/shapes/4/box", "eq": [640.0, 160.0, 256.0, 144.0]}]},
 {"tool": "render_slide", "args": {"scale": 1},
  "expect": [{"media": "$img", "width": 960, "height": 540},
             {"pixel": "$img", "x": 620, "y": 350, "rgb": [30, 132, 73], "tol": 6},
             {"pixel": "$img", "x": 768, "y": 204, "rgb": [240, 200, 40], "tol": 12},
             {"pixel": "$img", "x": 100, "y": 510, "rgb": [255, 255, 255], "tol": 4}]},
 {"tool": "run_command", "args": {"command": "slide.colorAt", "params": {"slide": 1, "x": 620, "y": 350}},
  "expect": [{"json": "/color", "eq": "1E8449"}]},
 {"tool": "save_presentation", "args": {"path": "{OUT}/smoke.deckcraft"},
  "expect": [{"json": "/bytes", "gte": 5000}, {"file": "{OUT}/smoke.deckcraft", "min_bytes": 5000},
             {"zip_text": "{OUT}/smoke.deckcraft", "member": "presentation.json", "contains": "Styled caption"},
             {"zip_text": "{OUT}/smoke.deckcraft", "member": "presentation.json", "contains": "DeckCraft smoke"}]},
 {"tool": "export", "args": {"path": "{OUT}/smoke.pptx"},
  "expect": [{"json": "/bytes", "gte": 10000},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/slides/slide2.xml", "contains": "<a:srgbClr val=\"1E8449\"/>"},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/slides/slide2.xml", "contains": "b=\"1\""},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/slides/slide2.xml", "contains": "sz=\"3600\""},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/slides/slide2.xml", "contains": "C0392B"},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/slides/slide2.xml", "contains": "Styled caption"},
             {"zip_text": "{OUT}/smoke.pptx", "member": "ppt/media/image1.png", "contains": "PNG"}]},
 {"tool": "export", "args": {"path": "{OUT}/smoke_slide1.png", "slide": 1, "scale": 1},
  "expect": [{"json": "/files/0", "contains": "smoke_slide1.png"},
             {"media": "{OUT}/smoke_slide1.png", "width": 960, "height": 540},
             {"pixel": "{OUT}/smoke_slide1.png", "x": 620, "y": 350, "rgb": [30, 132, 73], "tol": 6}]},
 {"tool": "run_command", "args": {"command": "file.info", "params": {}},
  "expect": [{"json": "/format", "eq": "deckcraft"}, {"json": "/dirty", "eq": false}, {"json": "/path", "contains": "smoke.deckcraft"}]},
 {"restart": true},
 {"tool": "open_presentation", "args": {"path": "{OUT}/smoke.deckcraft"},
  "expect": [{"json": "/slides", "eq": 2}, {"json": "/lostSlides", "len": 0}, {"json": "/damagedMedia", "len": 0},
             {"run": ["{CLI}", "info", "{OUT}/smoke.deckcraft"], "stdout_contains": "test_card.png"}]},
 {"tool": "run_command", "args": {"command": "file.info", "params": {}},
  "expect": [{"json": "/format", "eq": "deckcraft"}, {"json": "/slides", "eq": 2}]},
 {"tool": "run_command", "args": {"command": "text.find", "params": {"text": "Styled caption"}},
  "expect": [{"json": "", "len": 1}, {"json": "/0/slide", "eq": 1}, {"json": "/0/shape", "eq": "${cap_id}"}]},
 {"tool": "go_to_slide", "args": {"index": 1}},
 {"tool": "run_command", "args": {"command": "shape.inspect", "params": {"id": "${shape_id}"}},
  "expect": [{"json": "/shape/fill/color/base/rgb/r", "eq": 30}, {"json": "/shape/fill/color/base/rgb/g", "eq": 132},
             {"json": "/shape/fill/color/base/rgb/b", "eq": 73}, {"json": "/shape/text", "contains": "\"bold\": true"},
             {"json": "/shape/text", "contains": "\"size\": 36"}]},
 {"tool": "run_command", "args": {"command": "slide.colorAt", "params": {"slide": 1, "x": 768, "y": 204}},
  "expect": [{"json": "/color", "eq": "F0C828"}]},
 {"tool": "render_slide", "args": {"slide": 1, "scale": 1},
  "expect": [{"media": "$img", "width": 960, "height": 540},
             {"pixel": "$img", "x": 620, "y": 350, "rgb": [30, 132, 73], "tol": 6},
             {"pixel": "$img", "x": 768, "y": 204, "rgb": [240, 200, 40], "tol": 12}]},
 {"tool": "inspect_slide", "args": {"index": 1},
  "expect": [{"json": "/shapes", "len": 5}, {"json": "/shapes/4/box", "eq": [640.0, 160.0, 256.0, 144.0]},
             {"json": "/shapes/1/text", "eq": "Alpha line\nBeta line"}]},
 {"tool": "open_presentation", "args": {"path": "{OUT}/smoke.pptx"},
  "expect": [{"json": "/slides", "eq": 2}]},
 {"tool": "run_command", "args": {"command": "text.find", "params": {"text": "Cost"}},
  "expect": [{"json": "/0/slide", "eq": 1}, {"json": "/0/shape", "eq": "${shape_id}"}]},
 {"note": "The .pptx round trip keeps shape ids, boxes, fill, bold 36 and the picture; the slide id changes.",
  "tool": "go_to_slide", "args": {"index": 1}},
 {"tool": "run_command", "args": {"command": "shape.inspect", "params": {"id": "${shape_id}"}},
  "expect": [{"json": "/shape/fill/color/base/rgb/r", "eq": 30}, {"json": "/shape/fill/color/base/rgb/g", "eq": 132},
             {"json": "/shape/fill/color/base/rgb/b", "eq": 73}, {"json": "/shape/text", "contains": "\"bold\": true"},
             {"json": "/shape/text", "contains": "\"size\": 36"}, {"json": "/box/x", "eq": 600}, {"json": "/box/w", "eq": 300}]},
 {"tool": "inspect_slide", "args": {"index": 1},
  "expect": [{"json": "/id", "ne": "${slide_id}"}, {"json": "/shapes", "len": 5}, {"json": "/shapes/3/text", "eq": "Styled caption"},
             {"json": "/shapes/3/id", "eq": "${cap_id}"}, {"json": "/shapes/4/id", "eq": "${pic_id}"},
             {"json": "/shapes/4/kind", "eq": "picture"}, {"json": "/shapes/4/box", "eq": [640.0, 160.0, 256.0, 144.0]}]},
 {"tool": "render_slide", "args": {"slide": 1, "scale": 1},
  "expect": [{"media": "$img", "width": 960, "height": 540},
             {"pixel": "$img", "x": 620, "y": 350, "rgb": [30, 132, 73], "tol": 6},
             {"pixel": "$img", "x": 768, "y": 204, "rgb": [240, 200, 40], "tol": 12},
             {"pixel": "$img", "x": 100, "y": 510, "rgb": [255, 255, 255], "tol": 4}]},
 {"note": "A relative path resolves against the server's working folder (the write root here), is accepted inside a root, and is echoed relative.",
  "tool": "save_presentation", "args": {"path": "smoke_rel.deckcraft"},
  "expect": [{"json": "/path", "eq": "smoke_rel.deckcraft"}, {"file": "{OUT}/smoke_rel.deckcraft", "min_bytes": 5000},
             {"zip_text": "{OUT}/smoke_rel.deckcraft", "member": "presentation.json", "contains": "Styled caption"}]},
 {"tool": "open_presentation", "args": {"path": "smoke_rel.deckcraft"},
  "expect": [{"json": "/slides", "eq": 2}, {"json": "/lostSlides", "len": 0}]},
 {"tool": "run_command", "args": {"command": "file.info", "params": {}},
  "expect": [{"json": "/path", "eq": "smoke_rel.deckcraft"}, {"json": "/format", "eq": "deckcraft"}]}
]
