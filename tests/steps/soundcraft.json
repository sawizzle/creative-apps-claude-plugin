[
 {"label":"create a blank 48 kHz session. Flags: --automation-read-root {IN} --automation-read-root {OUT} --automation-write-root {OUT}; cwd {OUT} (the write root is not readable by itself, and step 18 reopens the save)","tool":"new_session","args":{"name":"MCP smoke test","template":"blank","sample_rate":48000},
  "expect":[{"json":"/sample_rate","eq":48000},{"json":"/name","eq":"MCP smoke test"}]},
 {"label":"claim the save path now: any smoke.scraft left by an earlier run becomes an empty session, so the reopen below proves the later save","tool":"save_session","args":{"path":"{OUT}/smoke.scraft","replace":true},
  "expect":[{"json":"/audio_files_written","eq":0},{"file_text":"{OUT}/smoke.scraft","contains":"\"tracks\": []"}]},
 {"label":"new mono track","tool":"execute","args":{"command":"track.new","params":{"name":"Tone","format":"mono"}},
  "capture":{"tone":"/tracks/0"},"expect":[{"json":"/tracks","len":1}]},
 {"label":"edit 1: 2 s of 1 kHz sine at -12 dBFS","tool":"execute","args":{"command":"audiosuite.process","params":{"process":"signal_generator","tracks":["${tone}"],"start":0,"end":{"seconds":2},"params":{"waveform":0,"freq":1000,"level":-12}}},
  "capture":{"tone_clip":"/clips/0"},"expect":[{"json":"/processed","eq":1},{"json":"/clips","len":1}]},
 {"label":"import the test clip's AAC audio onto a new track","tool":"import_audio","args":{"path":"{IN}/test_clip.mp4"},
  "capture":{"clip_track":"/imported/0/track"},"expect":[{"json":"/imported/0/channels","eq":1},{"json":"/imported/0/frames","gte":96000},{"json":"/imported/0/frames","lte":97280}]},
 {"label":"edit 2: Tone fader to -6 dB","tool":"execute","args":{"command":"mix.volume","params":{"tracks":["${tone}"],"db":-6}},
  "expect":[{"json":"/tracks","eq":1}]},
 {"label":"edit 3: Tone hard left","tool":"execute","args":{"command":"mix.pan","params":{"tracks":["${tone}"],"pan":-1}},
  "expect":[{"json":"/pan","eq":-1.0}]},
 {"label":"edit 4: mute the imported track","tool":"execute","args":{"command":"mix.mute","params":{"tracks":["${clip_track}"],"value":true}},
  "expect":[{"json":"/value","eq":true}]},
 {"label":"edit 5: marker at 1 s","tool":"execute","args":{"command":"markers.add","params":{"name":"Hit","at":{"seconds":1}}},
  "capture":{"marker":"/id"},"expect":[{"json":"/number","eq":1}]},
 {"label":"read back the Tone track","tool":"execute","args":{"command":"track.inspect","params":{"track":"${tone}"}},
  "expect":[{"json":"/volume_db","eq":-6.0},{"json":"/pan/0","eq":-1.0},{"json":"/mute","eq":false},{"json":"/clips/0/id","eq":"${tone_clip}"},{"json":"/clips/0/length","eq":96000}]},
 {"label":"read back the imported track","tool":"execute","args":{"command":"track.inspect","params":{"track":"${clip_track}"}},
  "expect":[{"json":"/mute","eq":true}]},
 {"label":"measurable result: bounce 0-2 s to 24-bit WAV (-12 dBFS, -6 dB fader, hard left = -18 dBFS peak; the muted clip adds nothing)","tool":"bounce_mix","args":{"path":"{OUT}/smoke_mix.wav","start":{"seconds":0},"end":{"seconds":2},"bit_depth":"24"},"timeout":120,
  "capture":{"bytes1":"/bytes","peak1":"/peak_db","lufs1":"/lufs"},
  "expect":[{"json":"/peak_db","approx":-18.0,"tol":0.05},{"json":"/lufs","approx":-21.0,"tol":0.1},{"json":"/seconds","eq":2.0},
            {"media":"{OUT}/smoke_mix.wav","codec":"pcm_s24le","duration":2.0}]},
 {"label":"export a common format: 16-bit FLAC","tool":"bounce_mix","args":{"path":"{OUT}/smoke_mix.flac","format":"flac","bit_depth":"16","start":{"seconds":0},"end":{"seconds":2}},"timeout":120,
  "expect":[{"json":"/peak_db","approx":-18.0,"tol":0.1},{"media":"{OUT}/smoke_mix.flac","codec":"flac","duration":2.0}]},
 {"label":"save native .scraft (writes Audio Files/ beside it; 2 files in an empty folder, 0 on a rerun because identical audio is reused)","tool":"save_session","args":{"path":"{OUT}/smoke.scraft","replace":true},
  "expect":[{"json":"/audio_files_written","in":[0,2]},{"file":"{OUT}/smoke.scraft","min_bytes":1000},
            {"file_text":"{OUT}/smoke.scraft","contains":"\"volume_db\": -6.0"},{"file_text":"{OUT}/smoke.scraft","contains":"\"name\": \"Hit\""},
            {"media":"{OUT}/Audio Files/Tone-signgene.wav","codec":"pcm_f32le","duration":2.0},
            {"run":["{CLI}","info","{OUT}/smoke.scraft"],"stdout_contains":"Hit"}]},
 {"label":"export the session listing as text","tool":"execute","args":{"command":"file.export_session_text","params":{"path":"{OUT}/smoke_info.txt","replace":true}},
  "expect":[{"file_text":"{OUT}/smoke_info.txt","contains":"STATE:\tMuted"},{"file_text":"{OUT}/smoke_info.txt","contains":"0:01.000\tHit"}]},
 {"restart":true},
 {"label":"fresh process starts empty","tool":"inspect_session","args":{"detail":"summary"},
  "expect":[{"json":"/name","eq":"Untitled"},{"json":"/tracks","len":0}]},
 {"label":"reopen the saved session","tool":"open_session","args":{"path":"{OUT}/smoke.scraft"},
  "expect":[{"json":"/missing","len":0},{"json":"/tracks","eq":2},{"json":"/name","eq":"smoke"}]},
 {"label":"Tone kept fader, pan and clip","tool":"execute","args":{"command":"track.inspect","params":{"track":"Tone"}},
  "expect":[{"json":"/volume_db","eq":-6.0},{"json":"/pan/0","eq":-1.0},{"json":"/clips/0/length","eq":96000}]},
 {"label":"imported track still muted","tool":"execute","args":{"command":"track.inspect","params":{"track":"test_clip"}},
  "expect":[{"json":"/mute","eq":true}]},
 {"label":"marker survived","tool":"inspect_session","args":{"detail":"summary"},
  "expect":[{"json":"/markers","len":1},{"json":"/markers/0/name","eq":"Hit"},{"json":"/markers/0/start","eq":48000},{"json":"/dirty","eq":false}]},
 {"label":"bounce after reopen matches the first bounce: same size, peak and LUFS, and a null test (first minus second, via ffmpeg) is digital silence","tool":"bounce_mix","args":{"path":"{OUT}/smoke_reopen.wav","start":{"seconds":0},"end":{"seconds":2},"bit_depth":"24"},"timeout":120,
  "expect":[{"json":"/bytes","eq":"${bytes1}"},{"json":"/peak_db","eq":"${peak1}"},{"json":"/lufs","eq":"${lufs1}"},{"media":"{OUT}/smoke_reopen.wav","codec":"pcm_s24le","duration":2.0},
            {"run":["ffmpeg","-hide_banner","-nostats","-i","{OUT}/smoke_mix.wav","-i","{OUT}/smoke_reopen.wav","-filter_complex","[1:a]aeval=-val(ch):c=same[n];[0:a][n]amix=inputs=2:normalize=0,astats=measure_perchannel=none:measure_overall=Peak_level","-f","null","-"],"stdout_contains":"Peak level dB: -inf"}]}
]
