[
 {"tool":"run_command","args":{"command":"file.new","params":{"name":"Smoke"}},
  "expect":[{"json":"/kind","eq":"design"}]},
 {"tool":"batch","args":{"label":"Smoke card","commands":[
   {"command":"node.create","as":"card","params":{"type":"frame","name":"Card","x":0,"y":0,"width":400,"height":240,"props":{"fill":"#3366FF","cornerRadius":16}}},
   {"command":"node.create","params":{"type":"text","name":"Title","text":"Hello FigCraft","parent":{"$ref":"card"},"x":24,"y":24,"props":{"fontFamily":"Inter","fontStyle":"Bold","fontSize":32,"fill":"#FFFFFF"}}},
   {"command":"node.create","params":{"type":"ellipse","name":"Dot","parent":{"$ref":"card"},"x":300,"y":140,"width":72,"height":72,"props":{"fill":"#FFD43B"}}}
  ]},
  "capture":{"card":"/0/id","title":"/1/id","dot":"/2/id"},
  "expect":[{"json":"","len":3}]},
 {"tool":"set_properties","args":{"ids":["${card}"],"props":{"fill":"#2B8A3E"}},
  "expect":[{"json":"/ok","eq":true},{"json":"/nodes/0/fills/0/color","eq":"#2B8A3E"}]},
 {"tool":"set_properties","args":{"ids":["${title}"],"props":{"characters":"Edited title"}},
  "expect":[{"json":"/nodes/0/characters","eq":"Edited title"}]},
 {"tool":"set_properties","args":{"ids":["${dot}"],"props":{"x":40}},
  "expect":[{"json":"/nodes/0/x","eq":40.0},{"json":"/nodes/0/absoluteBounds/x","eq":40.0}]},
 {"tool":"get_node","args":{"id":"${card}","depth":1,"fields":["name","type","fills","characters","x","y","width","height"]},
  "expect":[{"json":"/fills/0/color","eq":"#2B8A3E"},{"json":"/children/0/characters","eq":"Edited title"},
            {"json":"/children/1/x","eq":40.0},{"json":"/width","eq":400.0}]},
 {"tool":"screenshot","args":{},
  "expect":[{"json":"/width","eq":400},{"json":"/height","eq":240},{"json":"/source","eq":"page"},
            {"pixel":"$img","x":200,"y":200,"rgb":[43,138,62],"tol":6},
            {"pixel":"$img","x":76,"y":176,"rgb":[255,212,59],"tol":6},
            {"pixel":"$img","x":336,"y":176,"rgb":[43,138,62],"tol":6},
            {"pixel":"$img","x":28,"y":45,"rgb":[255,255,255],"tol":10},
            {"pixel":"$img","x":0,"y":0,"rgb":[245,245,245],"tol":4}]},
 {"tool":"save_file","args":{"path":"{OUT}/smoke.figcraft"},
  "expect":[{"json":"/bytes","gte":1000},{"file":"{OUT}/smoke.figcraft","min_bytes":1000},
            {"zip_text":"{OUT}/smoke.figcraft","member":"document.json","contains":"\"characters\":\"Edited title\""},
            {"run":["{CLI}","info","{OUT}/smoke.figcraft","--json"],"stdout_contains":"\"nodes\": 4"},
            {"run":["{CLI}","render","{OUT}/smoke.figcraft","-o","{OUT}/cli_render.png"]},
            {"pixel":"{OUT}/cli_render.png","x":200,"y":200,"rgb":[43,138,62],"tol":6},
            {"pixel":"{OUT}/cli_render.png","x":76,"y":176,"rgb":[255,212,59],"tol":6}]},
 {"tool":"export","args":{"format":"png","ids":["${card}"],"path":"{OUT}/smoke.png","scale":2},
  "expect":[{"media":"{OUT}/smoke.png","width":800,"height":480,"codec":"png"},
            {"pixel":"{OUT}/smoke.png","x":400,"y":400,"rgb":[43,138,62],"tol":6},
            {"pixel":"{OUT}/smoke.png","x":152,"y":352,"rgb":[255,212,59],"tol":6}]},
 {"tool":"export","args":{"format":"svg","ids":["${card}"],"path":"{OUT}/smoke.svg","svgOutlineText":false},
  "expect":[{"file_text":"{OUT}/smoke.svg","contains":"Edited title"},{"file_text":"{OUT}/smoke.svg","contains":"#2B8A3E"}]},
 {"tool":"export","args":{"ids":["${card}"],"path":"{OUT}/smoke.jpg"},
  "expect":[{"json":"/format","eq":"jpg"},{"media":"{OUT}/smoke.jpg","width":400,"height":240,"codec":"mjpeg"},
            {"pixel":"{OUT}/smoke.jpg","x":200,"y":200,"rgb":[43,138,62],"tol":10},
            {"pixel":"{OUT}/smoke.jpg","x":76,"y":176,"rgb":[255,212,59],"tol":12},
            {"pixel":"{OUT}/smoke.jpg","x":0,"y":0,"rgb":[255,255,255],"tol":10}]},
 {"tool":"export","args":{"format":"pdf","ids":["${card}"],"path":"{OUT}/smoke.pdf"},
  "expect":[{"json":"/format","eq":"pdf"},{"file":"{OUT}/smoke.pdf","min_bytes":1000},
            {"file_text":"{OUT}/smoke.pdf","contains":"%PDF-"},{"file_text":"{OUT}/smoke.pdf","contains":"/Count 1"},
            {"file_text":"{OUT}/smoke.pdf","contains":"/MediaBox[0 0 400 240]"}]},
 {"tool":"export","args":{"format":"png","ids":["${card}"],"path":"relative_in_cwd.png"},
  "expect":[{"json":"/path","eq":"relative_in_cwd.png"},{"media":"{OUT}/relative_in_cwd.png","width":400,"height":240},
            {"pixel":"{OUT}/relative_in_cwd.png","x":200,"y":200,"rgb":[43,138,62],"tol":6}]},
 {"restart":true},
 {"tool":"open_file","args":{"path":"{OUT}/smoke.figcraft"},
  "capture":{"card2":"/document/pages/0/children/0/id"},
  "expect":[{"json":"/document/name","eq":"Smoke"},{"json":"/document/dirty","eq":false},
            {"json":"/document/pages/0/children/0/name","eq":"Card"}]},
 {"tool":"get_node","args":{"id":"${card2}","depth":1,"fields":["name","fills","characters","x"]},
  "expect":[{"json":"/fills/0/color","eq":"#2B8A3E"},{"json":"/children/0/characters","eq":"Edited title"},
            {"json":"/children/1/x","eq":40.0},{"json":"/children/1/fills/0/color","eq":"#FFD43B"}]},
 {"tool":"screenshot","args":{},
  "expect":[{"json":"/width","eq":400},{"json":"/height","eq":240},
            {"pixel":"$img","x":200,"y":200,"rgb":[43,138,62],"tol":6},
            {"pixel":"$img","x":76,"y":176,"rgb":[255,212,59],"tol":6},
            {"pixel":"$img","x":336,"y":176,"rgb":[43,138,62],"tol":6},
            {"pixel":"$img","x":28,"y":45,"rgb":[255,255,255],"tol":10}]}
]
