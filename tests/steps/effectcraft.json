[
 {"tool": "open_project", "args": {"new": true},
  "expect": [{"json": "/items", "len": 0}]},
 {"tool": "command_run", "args": {"id": "comp.new", "params": {"name": "Main", "width": 640, "height": 360, "frameRate": 24, "duration": 2, "background": "#000000"}},
  "capture": {"comp": "/comp"}},
 {"tool": "command_run", "args": {"id": "file.import", "params": {"paths": ["{IN}/test_card.png"], "addToComp": true}},
  "expect": [{"json": "/errors", "len": 0}, {"json": "/items", "len": 1}]},
 {"tool": "get_comp", "args": {"comp": "${comp}"},
  "capture": {"card": "/layers/0/id"},
  "expect": [{"json": "/layers/0/name", "eq": "test_card.png"}, {"json": "/layers/0/type", "eq": "Footage"}]},
 {"tool": "set_property", "args": {"layer": "${card}", "path": "transform/scale", "value": [50, 50, 100]},
  "expect": [{"json": "/value/0", "approx": 50, "tol": 0.001}, {"json": "/value/1", "approx": 50, "tol": 0.001}]},
 {"tool": "command_run", "args": {"id": "layer.newShape", "params": {"kind": "rect", "size": [160, 160], "fill": "#ff0000", "position": [160, 180], "name": "Box"}},
  "capture": {"box": "/layer"}},
 {"tool": "command_run", "args": {"id": "layer.newText", "params": {"text": "SMOKE 019", "size": 48, "fill": "#ffffff", "name": "Title", "position": [320, 330]}},
  "capture": {"title": "/layer"}},
 {"tool": "add_effect", "args": {"layer": "${box}", "effect": "Fill", "values": {"color": "#00ff00"}},
  "expect": [{"json": "/path", "eq": "effects/#1"}, {"json": "/set", "contains": "effects/#1/color"}]},
 {"tool": "add_keyframe", "args": {"layer": "${box}", "path": "transform/position", "keys": [{"time": 0, "value": [160, 180]}, {"time": 1.5, "value": [480, 180]}], "interpolation": "linear"},
  "expect": [{"json": "/keys", "len": 2}, {"json": "/keys/1/value/0", "approx": 480, "tol": 0.001}]},
 {"tool": "get_property", "args": {"layer": "${box}", "path": "transform/position", "time": 0.75},
  "expect": [{"json": "/value/0", "approx": 320, "tol": 0.01}, {"json": "/animated", "eq": true}]},
 {"tool": "set_property", "args": {"layer": "${box}", "path": "transform/rotation", "expression": "time*45"},
  "expect": [{"json": "/expression", "eq": "time*45"}, {"json": "/expressionError", "exists": false}]},
 {"tool": "get_property", "args": {"layer": "${box}", "path": "transform/rotation", "time": 1},
  "expect": [{"json": "/evaluated", "approx": 45, "tol": 0.001}, {"json": "/value", "approx": 0, "tol": 0.001}]},
 {"tool": "render_preview", "args": {"time": 0, "max_side": 640},
  "expect": [{"media": "$img", "width": 640, "height": 360},
             {"pixel": "$img", "x": 160, "y": 180, "rgb": [0, 255, 0], "tol": 6},
             {"pixel": "$img", "x": 35, "y": 180, "rgb": [0, 200, 90], "tol": 10},
             {"pixel": "$img", "x": 600, "y": 180, "rgb": [210, 60, 230], "tol": 10},
             {"pixel": "$img", "x": 320, "y": 110, "rgb": [240, 200, 40], "tol": 10},
             {"pixel": "$img", "x": 225, "y": 297, "rgb": [255, 255, 255], "tol": 10}]},
 {"tool": "render_frame", "args": {"time": 1, "max_side": 0, "path": "{OUT}/effectcraft_t1.png", "inline": false},
  "expect": [{"media": "{OUT}/effectcraft_t1.png", "width": 640, "height": 360},
             {"pixel": "{OUT}/effectcraft_t1.png", "x": 373, "y": 180, "rgb": [0, 255, 0], "tol": 6},
             {"pixel": "{OUT}/effectcraft_t1.png", "x": 303, "y": 110, "rgb": [240, 200, 40], "tol": 10},
             {"pixel": "{OUT}/effectcraft_t1.png", "x": 225, "y": 297, "rgb": [255, 255, 255], "tol": 10}]},
 {"tool": "command_run", "args": {"id": "renderQueue.add", "params": {"comp": "Main", "format": "h264", "output": "{OUT}/effectcraft_out.mp4"}},
  "expect": [{"json": "/frames", "eq": 48}, {"json": "/output/format", "eq": "H264"}]},
 {"tool": "command_run", "args": {"id": "renderQueue.render", "params": {"wait": true}}, "timeout": 300,
  "expect": [{"json": "/failed", "eq": 0},
             {"media": "{OUT}/effectcraft_out.mp4", "codec": "h264", "width": 640, "height": 360, "fps": 24, "frames": 48},
             {"run": ["ffmpeg", "-v", "error", "-y", "-i", "{OUT}/effectcraft_out.mp4", "-frames:v", "1", "{OUT}/effectcraft_out_f0.png"], "exit": 0},
             {"pixel": "{OUT}/effectcraft_out_f0.png", "x": 160, "y": 180, "rgb": [0, 255, 0], "tol": 30},
             {"pixel": "{OUT}/effectcraft_out_f0.png", "x": 600, "y": 180, "rgb": [210, 60, 230], "tol": 30},
             {"run": ["ffmpeg", "-v", "error", "-y", "-ss", "1", "-i", "{OUT}/effectcraft_out.mp4", "-frames:v", "1", "{OUT}/effectcraft_out_f24.png"], "exit": 0},
             {"pixel": "{OUT}/effectcraft_out_f24.png", "x": 373, "y": 180, "rgb": [0, 255, 0], "tol": 30},
             {"pixel": "{OUT}/effectcraft_out_f24.png", "x": 303, "y": 110, "rgb": [240, 200, 40], "tol": 30},
             {"pixel": "{OUT}/effectcraft_out_f24.png", "x": 225, "y": 297, "rgb": [255, 255, 255], "tol": 30}]},
 {"tool": "save_project", "args": {"path": "{OUT}/effectcraft_out.ecproj"},
  "expect": [{"json": "/dirty", "eq": false}, {"file": "{OUT}/effectcraft_out.ecproj", "min_bytes": 1000},
             {"file_text": "{OUT}/effectcraft_out.ecproj", "contains": "SMOKE 019"},
             {"file_text": "{OUT}/effectcraft_out.ecproj", "contains": "time*45"}]},
 {"restart": true},
 {"tool": "open_project", "args": {"path": "{OUT}/effectcraft_out.ecproj"},
  "expect": [{"json": "/dirty", "eq": false}, {"json": "/path", "contains": "effectcraft_out.ecproj"}]},
 {"tool": "get_comp", "args": {"comp": "Main"},
  "expect": [{"json": "/layers", "len": 3}, {"json": "/layers/0/name", "eq": "Title"}, {"json": "/layers/1/name", "eq": "Box"},
             {"json": "/layers/2/name", "eq": "test_card.png"}, {"json": "/frameRate", "eq": 24.0}]},
 {"tool": "get_property", "args": {"comp": "Main", "layer": "Title", "path": "text/sourceText"},
  "expect": [{"json": "/value", "eq": "SMOKE 019"}]},
 {"tool": "get_property", "args": {"comp": "Main", "layer": "Box", "path": "effects/#1/color"},
  "expect": [{"json": "/value", "eq": [0.0, 1.0, 0.0, 1.0]}]},
 {"tool": "get_property", "args": {"comp": "Main", "layer": "Box", "path": "transform/rotation", "time": 1},
  "expect": [{"json": "/expression", "eq": "time*45"}, {"json": "/evaluated", "approx": 45, "tol": 0.001}]},
 {"tool": "render_frame", "args": {"comp": "Main", "time": 1.5, "max_side": 0, "path": "{OUT}/effectcraft_reopen.png", "inline": false},
  "expect": [{"media": "{OUT}/effectcraft_reopen.png", "width": 640, "height": 360},
             {"pixel": "{OUT}/effectcraft_reopen.png", "x": 480, "y": 180, "rgb": [0, 255, 0], "tol": 6},
             {"pixel": "{OUT}/effectcraft_reopen.png", "x": 160, "y": 180, "rgb": [60, 160, 130], "tol": 10},
             {"pixel": "{OUT}/effectcraft_reopen.png", "x": 600, "y": 180, "rgb": [210, 60, 230], "tol": 10},
             {"pixel": "{OUT}/effectcraft_reopen.png", "x": 225, "y": 297, "rgb": [255, 255, 255], "tol": 10}]}
]
