            {"json":"/layers/0/id","eq":"${card}"},{"json":"/layers/0/smartFilters/0/params/radius","eq":4},
            {"json":"/layers/1/id","eq":"${title}"},{"json":"/layers/1/kind","eq":"Type"},
            {"json":"/layers/2/id","eq":"${box}"},{"json":"/layers/2/opacity","approx":0.5,"tol":0.001}]},
 {"tool":"command_run","args":{"id":"type.info","params":{"layer":"${title}"}},
  "expect":[{"json":"/text","eq":"PHOTOCRAFT SMOKE"},{"json":"/runs/0/style/size_pt","eq":36.0}]},
 {"tool":"doc_render_preview","args":{"max_side":640},
  "expect":[{"pixel":"$img","x":140,"y":100,"rgb":[255,128,128],"tol":8},
