            {"pixel":"$img","x":600,"y":370,"rgb":[255,255,255],"tol":2},
            {"pixel":"$img","x":357,"y":150,"rgb":[26,131,95],"tol":20},
            {"pixel":"$img","x":230,"y":150,"rgb":[255,128,128],"tol":8}]},
 {"tool":"doc_save","args":{"path":"{OUT}/photocraft_smoke.pcraft"},
  "expect":[{"json":"/warnings","len":0},{"file":"{OUT}/photocraft_smoke.pcraft","min_bytes":10000}]},
 {"tool":"doc_export","args":{"path":"{OUT}/photocraft_smoke.png"},
