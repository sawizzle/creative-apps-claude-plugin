 {"restart":true},
 {"tool":"doc_open","args":{"path":"{OUT}/photocraft_smoke.pcraft"},
  "expect":[{"json":"/layers","eq":4},{"json":"/width","eq":640},{"json":"/height","eq":400}]},
 {"tool":"doc_inspect","args":{},
