 {"tool":"command_run","args":{"id":"filter.blur.gaussianBlur","params":{"radius":4}},
  "expect":[{"json":"/filter/radius","eq":4.0},{"json":"/layer","eq":"${card}"}]},
 {"tool":"command_run","args":{"id":"layer.setProps","params":{"layer":"${box}","opacity":0.5}}},
 {"tool":"doc_inspect","args":{},
  "expect":[{"json":"/layers","len":4},
            {"json":"/layers/0/id","eq":"${card}"},{"json":"/layers/0/kind","eq":"Smart Object"},
            {"json":"/layers/0/smartFilters/0/command","eq":"filter.blur.gaussianBlur"},
            {"json":"/layers/1/id","eq":"${title}"},{"json":"/layers/1/text/text","eq":"PHOTOCRAFT SMOKE"},
            {"json":"/layers/2/id","eq":"${box}"},{"json":"/layers/2/opacity","approx":0.5,"tol":0.001},
            {"json":"/history","len":6}]},
 {"tool":"doc_render_preview","args":{"max_side":640},
