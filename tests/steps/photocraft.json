[{"tool":"doc_new","args":{"width":640,"height":400,"background":"#ffffff","name":"smoke"},
  "expect":[{"json":"/document","eq":0}]},
 {"tool":"command_run","args":{"id":"shape.create","params":{"kind":"rect","rect":[40,40,200,120],"fill":"#ff0000","name":"RedBox"}},
  "capture":{"box":"/layer"},
  "expect":[{"json":"/bounds","eq":[40,40,200,120]},{"json":"/fill","eq":"#ff0000"},{"json":"/kind","eq":"rect"}]},
 {"tool":"command_run","args":{"id":"type.create","params":{"x":60,"y":300,"text":"PHOTOCRAFT SMOKE","size":36,"color":"#0000ff","name":"Title"}},
  "capture":{"title":"/layer"},
  "expect":[{"json":"/bounds/0","approx":62,"tol":4},{"json":"/bounds/3","approx":302,"tol":4}]},
 {"tool":"doc_place","args":{"path":"{IN}/test_card.png","scale":25,"center":[480,120]},
