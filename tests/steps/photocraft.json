            {"media":"{OUT}/photocraft_smoke.png","width":640,"height":400,"codec":"png"},
            {"pixel":"{OUT}/photocraft_smoke.png","x":140,"y":100,"rgb":[255,128,128],"tol":8},
            {"pixel":"{OUT}/photocraft_smoke.png","x":480,"y":85,"rgb":[240,200,40],"tol":10},
            {"pixel":"{OUT}/photocraft_smoke.png","x":64,"y":285,"rgb":[0,0,255],"tol":20},
            {"pixel":"{OUT}/photocraft_smoke.png","x":357,"y":150,"rgb":[26,131,95],"tol":20},
            {"pixel":"{OUT}/photocraft_smoke.png","x":230,"y":150,"rgb":[255,128,128],"tol":8}]},
 {"tool":"doc_export","args":{"path":"{OUT}/photocraft_smoke.jpg","quality":90},
  "expect":[{"text_contains":"lossy compression"},
            {"media":"{OUT}/photocraft_smoke.jpg","width":640,"height":400,"codec":"mjpeg"}]},
 {"tool":"session_list","args":{},
  "expect":[{"json":"/documents/0/dirty","eq":false},
