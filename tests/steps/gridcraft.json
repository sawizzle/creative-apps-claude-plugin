[
 {"tool": "new_workbook", "args": {}, "expect": [{"json": "/title", "eq": "Book2"}]},
 {"tool": "list_windows", "args": {}, "capture": {"doc": "/1/doc"},
  "expect": [{"json": "", "len": 2}, {"json": "/1/active", "eq": true}, {"json": "/1/title", "eq": "Book2"}]},
 {"tool": "write_range", "args": {"doc": "${doc}", "range": "A1", "values": [["Item", "Cost"], ["Rent", 1200], ["Power", 85.5], ["Total", "=SUM(B2:B3)"]]},
  "expect": [{"json": "/cells", "eq": 8}]},
 {"tool": "format_range", "args": {"doc": "${doc}", "range": "A1:B1", "bold": true, "fillColor": "#FFD966", "borders": "bottom"},
  "expect": [{"json": "/applied", "eq": ["home.bold", "home.fillColor", "home.borders"]}]},
 {"tool": "format_range", "args": {"doc": "${doc}", "range": "B2:B4", "numberFormat": "Currency"},
  "expect": [{"json": "/applied", "eq": ["home.numberFormat"]}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "home.autofitColumnWidth", "params": {"cols": "A:B"}}},
 {"tool": "insert_chart", "args": {"doc": "${doc}", "range": "A1:B3", "type": "column", "title": "Draft title", "at": "A7"},
  "capture": {"chart": "/chart"}, "expect": [{"json": "/chart", "gte": 1}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "chart.set", "params": {"chart": "${chart}", "title": "MCP smoke test", "legend": "right"}}},
 {"tool": "read_range", "args": {"doc": "${doc}", "range": "A1:B4"},
  "expect": [{"json": "/values/1/1", "eq": 1200}, {"json": "/values/3/1", "approx": 1285.5, "tol": 1e-9}]},
 {"tool": "read_range", "args": {"doc": "${doc}", "range": "A1:B4", "formatted": true},
  "expect": [{"json": "/values/1/1", "eq": "$1,200.00"}, {"json": "/values/3/1", "eq": "$1,285.50"}]},
 {"tool": "evaluate_formula", "args": {"doc": "${doc}", "formula": "=B4*2"}, "expect": [{"json": "/result", "approx": 2571, "tol": 1e-9}]},
 {"tool": "inspect_workbook", "args": {"doc": "${doc}"},
  "expect": [{"json": "/dirty", "eq": true}, {"json": "/path", "eq": null}, {"json": "/sheets/0/usedRange", "eq": "A1:B4"},
             {"json": "/sheets/0/charts", "len": 1}, {"json": "/sheets/0/charts/0/id", "eq": "${chart}"},
             {"json": "/sheets/0/charts/0/title", "eq": "MCP smoke test"}, {"json": "/sheets/0/charts/0/at", "eq": "A7"},
             {"json": "/sheets/0/charts/0/kind", "eq": "ColumnClustered"}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "file.printPreview", "params": {}},
  "expect": [{"json": "/pages", "eq": 1}, {"json": "/pageList/0/range", "eq": "A1:H21"}, {"json": "/pageList/0/paper", "eq": "Letter"}]},
 {"tool": "save_workbook", "args": {"doc": "${doc}", "path": "{OUT}/gridcraft_smoke.xlsx"},
  "expect": [{"json": "/bytes", "gte": 3000},
             {"file": "{OUT}/gridcraft_smoke.xlsx", "min_bytes": 3000},
             {"zip_text": "{OUT}/gridcraft_smoke.xlsx", "member": "xl/worksheets/sheet1.xml", "contains": "<f>SUM(B2:B3)</f><v>1285.5</v>"},
             {"zip_text": "{OUT}/gridcraft_smoke.xlsx", "member": "xl/worksheets/sheet1.xml", "contains": "customWidth=\"1\""},
             {"zip_text": "{OUT}/gridcraft_smoke.xlsx", "member": "xl/styles.xml", "contains": "<fgColor rgb=\"FFFFD966\"/>"},
             {"zip_text": "{OUT}/gridcraft_smoke.xlsx", "member": "xl/charts/chart1.xml", "contains": "<a:t>MCP smoke test</a:t>"},
             {"zip_text": "{OUT}/gridcraft_smoke.xlsx", "member": "xl/charts/chart1.xml", "contains": "<c:legendPos val=\"r\"/>"},
             {"run": ["{CLI}", "check", "{OUT}/gridcraft_smoke.xlsx"], "stdout_contains": "round trip: all equal", "exit": 0},
             {"run": ["{CLI}", "info", "{OUT}/gridcraft_smoke.xlsx"], "stdout_contains": "chart ColumnClustered \"MCP smoke test\" at A7", "exit": 0}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "file.exportPdf", "params": {"path": "{OUT}/gridcraft_smoke.pdf"}},
  "expect": [{"json": "/pages", "eq": 1}, {"file": "{OUT}/gridcraft_smoke.pdf", "min_bytes": 2000},
             {"file_text": "{OUT}/gridcraft_smoke.pdf", "contains": "/Count 1"},
             {"file_text": "{OUT}/gridcraft_smoke.pdf", "contains": "($1,285.50) Tj"},
             {"file_text": "{OUT}/gridcraft_smoke.pdf", "contains": "1 0.851 0.4 rg"},
             {"file_text": "{OUT}/gridcraft_smoke.pdf", "contains": "(MCP smoke test) Tj"}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "file.exportCsv", "params": {"path": "{OUT}/gridcraft_smoke_values.csv", "values": true}},
  "expect": [{"file_text": "{OUT}/gridcraft_smoke_values.csv", "contains": "Total,1285.5"}]},
 {"tool": "execute_command", "args": {"doc": "${doc}", "command": "file.exportCsv", "params": {"path": "{OUT}/gridcraft_smoke_shown.csv"}},
  "expect": [{"file_text": "{OUT}/gridcraft_smoke_shown.csv", "contains": "Total,\"$1,285.50\""}]},
 {"tool": "inspect_workbook", "args": {"doc": "${doc}"},
  "expect": [{"json": "/dirty", "eq": false}, {"json": "/path", "contains": "gridcraft_smoke.xlsx"}, {"json": "/trust", "eq": "local"}]},
 {"tool": "set_cell", "args": {"doc": "${doc}", "cell": "C1", "input": "UNSAVED CANARY"}, "expect": [{"json": "/value", "eq": "UNSAVED CANARY"}]},
 {"tool": "list_windows", "args": {}, "expect": [{"json": "/1/dirty", "eq": true}]},
 {"restart": true},
 {"tool": "list_windows", "args": {}, "expect": [{"json": "", "len": 1}, {"json": "/0/title", "eq": "Book1"}]},
 {"tool": "open_workbook", "args": {"path": "{OUT}/gridcraft_smoke.xlsx"},
  "expect": [{"json": "/sheets", "eq": ["Sheet1"]}, {"json": "/warnings", "len": 0}, {"json": "/title", "eq": "gridcraft_smoke.xlsx"}]},
 {"tool": "inspect_workbook", "args": {},
  "expect": [{"json": "/dirty", "eq": false}, {"json": "/trust", "eq": "fromFile"}, {"json": "/sheets/0/cells", "eq": 8},
             {"json": "/sheets/0/usedRange", "eq": "A1:B4"}, {"json": "/sheets/0/charts/0/title", "eq": "MCP smoke test"},
             {"json": "/sheets/0/charts/0/at", "eq": "A7"}]},
 {"tool": "read_range", "args": {"sheet": "Sheet1", "range": "A1:C4", "formulas": true},
  "expect": [{"json": "/values/3/1", "eq": "=SUM(B2:B3)"}, {"json": "/values/0/0", "eq": "Item"}, {"json": "/values/0/2", "eq": null}]},
 {"tool": "read_range", "args": {"sheet": "Sheet1", "range": "A1:B4", "formatted": true},
  "expect": [{"json": "/values/3/1", "eq": "$1,285.50"}, {"json": "/values/2/1", "eq": "$85.50"}]},
 {"tool": "get_cell", "args": {"cell": "A1"},
  "expect": [{"json": "/style/font/bold", "eq": true}, {"json": "/style/fill/fg/Rgb", "eq": 16767334},
             {"json": "/style/borders/bottom/style", "eq": "Thin"}]},
 {"tool": "evaluate_formula", "args": {"formula": "=B4*2"}, "expect": [{"json": "/result", "approx": 2571, "tol": 1e-9}]},
 {"tool": "execute_command", "args": {"command": "file.exportPdf", "params": {"path": "{OUT}/gridcraft_reopened.pdf"}},
  "expect": [{"json": "/pages", "eq": 1},
             {"file_text": "{OUT}/gridcraft_reopened.pdf", "contains": "($1,285.50) Tj"},
             {"file_text": "{OUT}/gridcraft_reopened.pdf", "contains": "1 0.851 0.4 rg"},
             {"file_text": "{OUT}/gridcraft_reopened.pdf", "contains": "(MCP smoke test) Tj"}]}
]
