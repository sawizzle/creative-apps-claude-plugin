{
  "mcpServers": {
    "photocraft": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/craft-mcp.mjs",
        "photocraft",
        "mcp"
      ],
      "env": {
        "CRAFT_OPT_WRITE_ROOT": "${user_config.write_root}",
        "CRAFT_OPT_READ_SCOPE": "${user_config.read_scope}",
        "CRAFT_OPT_EXTRA_READ_ROOT": "${user_config.extra_read_root}",
        "CRAFT_OPT_PHOTOCRAFT_READ_ROOT": "${user_config.photocraft_read_root}",
        "CRAFT_OPT_PHOTOCRAFT_WRITE_ROOT": "${user_config.photocraft_write_root}"
      }
    },
